# ═══════════════════════════════════════════════
#  WhatsApp Ticket Trading Bot — Configuration
# ═══════════════════════════════════════════════

# ── WhatsApp ──
# Your bot's WhatsApp number (with country code, no spaces)
WA_PAIRING_PHONE=+911234567890

# ── Registration ──
# Secret password for admin registration (change this!)
# Admins DM the bot: "register <secret>" to get access
REGISTER_SECRET=changeme123

# ── Allowlist (optional) ──
# Pre-approved numbers (comma separated). Leave empty to use registration only.
ALLOWLIST=

# ── Google Sheets ──
# Service account JSON file (for Google Sheets backup)
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Delivery tab config (Sheet1 = delivery tab)
DELIVERY_SHEET_NAME=Sheet1
DELIVERY_COL_PHONE=A
DELIVERY_COL_LINK=B
DELIVERY_COL_STATUS=C

# Trades backup tab (auto-created if doesn't exist)
TRADES_SHEET_NAME=Trades
SYNC_TRADES_TO_SHEETS=true

# ── AI (choose one) ──

# Option 1: OpenClaw (local AI gateway)
OPENCLAW_BASE_URL=http://127.0.0.1:18789/v1
OPENCLAW_API_KEY=your_openclaw_api_key
AI_MODEL=claude-sonnet-4-20250514

# Option 2: Gemini (uncomment and set key to use instead)
# GEMINI_API_KEY=your_gemini_api_key

# ── Delivery ──
# How often to check for pending deliveries (minutes)
DELIVERY_POLL_INTERVAL=5
